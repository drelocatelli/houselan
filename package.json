{
  "name": "HouseLan",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "dev:android": "ionic capacitor run android -l --external --device --consolelogs --serverlogs --mode dev",
    "electron": "npx tsc -p electron && NODE_ENV=development npx electron electron",
    "build": "npm run build:front && npm run build:desktop",
    "build:front": "rm -rf dist && rm -rf electron/dist && npx ionic build && npx cap copy electron",
    "build:electron": "npx tsc -p electron",
    "build:desktop": "npm run build:electron && cd electron && npm run electron:make -- --publish never"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "dexie": "^4.4.5",
    "ionicons": "^8.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@ionic/cli": "^7.2.1",
    "@types/minimatch": "^5.1.2",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "concurrently": "^10.0.5",
    "copyfiles": "^2.4.1",
    "cypress": "^13.5.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^2.1.10",
    "wait-on": "^9.1.0"
  },
  "description": "An Ionic project"
}
